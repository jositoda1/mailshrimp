{
  "name": "@mailshrimp/http",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared HTTP protocol primitives used by MailShrimp applications and services.",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --verbose",
    "test:watch": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --watch --verbose",
    "test:coverage": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --coverage --verbose",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  }
}