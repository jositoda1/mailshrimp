# MailShrimp accounts-service environment configuration.
#
# I keep this file in source control as documentation of the environment
# variables required by the service. It must never contain real credentials,
# production secrets, or copied values from a developer's local .env file.

# Optional HTTP port.
# When omitted, accounts-service uses its documented default port: 3111.
PORT=3111

# Secret used to sign and verify short-lived access tokens.
#
# Replace this placeholder with a cryptographically strong random value in the
# real environment. Access and refresh tokens deliberately use different
# secrets so compromise of one signing key does not automatically expose both
# token classes.
ACCESS_TOKEN_SECRET=replace-with-a-strong-random-access-token-secret

# Secret used to sign and verify refresh tokens.
#
# This value must be different from ACCESS_TOKEN_SECRET. The real value belongs
# only in the environment/secret store and must never be committed to Git.
REFRESH_TOKEN_SECRET=replace-with-a-different-strong-random-refresh-token-secret